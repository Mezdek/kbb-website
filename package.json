{
  "name": "kbb",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run prebuild && next dev",
    "prebuild": "npm run generate:types",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "npm run generate:types",
    "typecheck": "tsc --noEmit",
    "generate:types": "json2ts -i schemas -o src/types",
    "pretest": "npm run generate:types",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "markdown-to-jsx": "^9.10.0",
    "next": "^16.3.0",
    "next-intl": "^4.13.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "json-schema-to-typescript": "^15.0.4",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
