{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kulturbruecke-brandenburg.de/schemas/prayer-times.schema.json",
  "title": "PrayerTimes",
  "description": "Output of the prayer times generator. Times are local wall-clock time at the configured location and timezone, in 24-hour HH:mm. Isha may fall after midnight and is then written as e.g. 00:14 under the date it was calculated for.",
  "type": "object",
  "required": ["meta", "days"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "description": "Provenance and the exact settings that produced this file. Operator-defined fields (address, phone, and so on) may be added alongside the required ones.",
      "required": ["year", "generatedAt", "calculation"],
      "additionalProperties": true,
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200,
          "description": "The Gregorian year every key in `days` belongs to."
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of generation."
        },
        "generator": {
          "type": "string",
          "minLength": 1,
          "description": "Free text naming who or what produced the file."
        },
        "calculation": {
          "type": "object",
          "required": ["location", "calculation", "adjustments"],
          "additionalProperties": false,
          "properties": {
            "location": {
              "type": "object",
              "required": ["latitude", "longitude", "elevation", "timezone"],
              "additionalProperties": false,
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90,
                  "description": "Decimal degrees, north positive."
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180,
                  "description": "Decimal degrees, east positive."
                },
                "elevation": {
                  "type": "number",
                  "minimum": -500,
                  "maximum": 9000,
                  "description": "Metres above sea level. Affects Shuruq and Maghrib only; the angle-based prayers are unaffected."
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z][A-Za-z0-9+_-]*(/[A-Za-z0-9+._-]+)*$",
                  "description": "IANA timezone identifier, e.g. Europe/Berlin. Used for the wall-clock conversion including DST."
                }
              }
            },
            "calculation": {
              "type": "object",
              "required": ["fajrAngle", "ishaAngle", "asrMethod"],
              "additionalProperties": false,
              "properties": {
                "fajrAngle": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 25,
                  "description": "Solar depression below the horizon, in degrees, positive."
                },
                "ishaAngle": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 25,
                  "description": "Solar depression below the horizon, in degrees, positive."
                },
                "asrMethod": {
                  "type": "integer",
                  "enum": [1, 2],
                  "description": "Shadow factor. 1 = Shafi'i / Hanbali / Maliki, 2 = Hanafi."
                }
              }
            },
            "adjustments": {
              "type": "object",
              "required": ["minuteOffsets", "hijriOffsetDays"],
              "additionalProperties": false,
              "properties": {
                "minuteOffsets": {
                  "type": "object",
                  "description": "Applied after rounding, per prayer.",
                  "required": ["fajr", "shuruq", "dhuhr", "asr", "maghrib", "isha"],
                  "additionalProperties": false,
                  "properties": {
                    "fajr": { "$ref": "#/$defs/minuteOffset" },
                    "shuruq": { "$ref": "#/$defs/minuteOffset" },
                    "dhuhr": { "$ref": "#/$defs/minuteOffset" },
                    "asr": { "$ref": "#/$defs/minuteOffset" },
                    "maghrib": { "$ref": "#/$defs/minuteOffset" },
                    "isha": { "$ref": "#/$defs/minuteOffset" }
                  }
                },
                "hijriOffsetDays": {
                  "type": "integer",
                  "minimum": -2,
                  "maximum": 2,
                  "description": "Single global correction applied to every date before conversion. The Hijri dates in `days` are already corrected."
                }
              }
            }
          }
        }
      }
    },
    "days": {
      "type": "object",
      "description": "One entry per calendar day of meta.year, keyed by ISO date.",
      "minProperties": 365,
      "maxProperties": 366,
      "propertyNames": {
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
      },
      "additionalProperties": { "$ref": "#/$defs/day" }
    }
  },
  "$defs": {
    "minuteOffset": {
      "type": "integer",
      "minimum": -60,
      "maximum": 60
    },
    "time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "Local wall-clock time, 24-hour HH:mm."
    },
    "day": {
      "type": "object",
      "required": ["fajr", "shuruq", "dhuhr", "asr", "maghrib", "isha", "hijri"],
      "additionalProperties": false,
      "properties": {
        "fajr": { "$ref": "#/$defs/time" },
        "shuruq": { "$ref": "#/$defs/time" },
        "dhuhr": { "$ref": "#/$defs/time" },
        "asr": { "$ref": "#/$defs/time" },
        "maghrib": { "$ref": "#/$defs/time" },
        "isha": { "$ref": "#/$defs/time" },
        "hijri": {
          "type": "object",
          "required": ["day", "month", "year"],
          "additionalProperties": false,
          "properties": {
            "day": { "type": "integer", "minimum": 1, "maximum": 30 },
            "month": { "type": "integer", "minimum": 1, "maximum": 12 },
            "year": {
              "type": "integer",
              "minimum": 1300,
              "maximum": 1600,
              "description": "Umm al-Qura tables cover roughly this range."
            }
          }
        }
      }
    }
  }
}
